# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── AI / Vector Search ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=mediguard-health-knowledge

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD empty to run in dev mode (no emails sent).
# Gmail: enable "App Passwords" under Google Account → Security → 2-Step Verification
#        then generate a 16-character app password and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=MediGuard Bamenda <your-gmail@gmail.com>

# URL of the deployed frontend (used to build password-reset links in emails)
FRONTEND_URL=https://your-frontend.vercel.app
